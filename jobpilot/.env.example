# ── JOBPILOT Environment Configuration ────────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=JOBPILOT
DEBUG=false
SECRET_KEY=change-this-to-a-long-random-string-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./jobpilot.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/jobpilot

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=llama3-8b-8192

# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Alternative: OpenRouter (access 100+ models)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=google/gemini-2.5-flash

# ── Candidate Profile ─────────────────────────────────────────────────────────
CANDIDATE_NAME=Your Name
CANDIDATE_EMAIL=your.email@gmail.com
CANDIDATE_LOCATION=Islamabad, Pakistan
CANDIDATE_TIMEZONE=Asia/Karachi
CANDIDATE_WORK_AUTHORIZATION=Pakistan
CANDIDATE_REMOTE_PREFERENCE=worldwide_remote

# ── Job Scoring Thresholds ────────────────────────────────────────────────────
SCORE_HIGH_PRIORITY=90
SCORE_GOOD_MATCH=75
SCORE_POSSIBLE_MATCH=60
SCORE_AUTO_APPROVE=40
SCORE_MIN_THRESHOLD=30

# ── Application Settings ──────────────────────────────────────────────────────
APPLICATION_MODE=manual
# Options: manual | approval | controlled
REQUIRE_APPROVAL=true
MAX_APPLICATIONS_PER_DAY=10
AUTO_APPLICATION_ENABLED=false

# ── Scraping ──────────────────────────────────────────────────────────────────
RESULTS_PER_TERM=15
SCRAPE_INTERVAL_HOURS=6

# ── WhatsApp (Official Meta Business API) ─────────────────────────────────────
# Get access at: https://developers.facebook.com/docs/whatsapp
# STATUS: PENDING_CONFIGURATION
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Email OAuth ───────────────────────────────────────────────────────────────
# Gmail: https://console.cloud.google.com → Create OAuth 2.0 credentials
# STATUS: PENDING_CONFIGURATION
EMAIL_PROVIDER=gmail
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=
EMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/auth/email/callback

# ── Telegram Notifications ───────────────────────────────────────────────────
# Create bot: https://t.me/BotFather → /newbot → copy token
# Get chat ID: message your bot, then visit:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Auto-Apply Credentials ────────────────────────────────────────────────────
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
INDEED_EMAIL=
INDEED_PASSWORD=
ROZEE_EMAIL=
ROZEE_PASSWORD=

# ── Auto-Apply Limits ─────────────────────────────────────────────────────────
DAILY_APPLY_LIMIT_TIER1=15
DAILY_APPLY_LIMIT_TIER2=15

# ── CV Storage ────────────────────────────────────────────────────────────────
CV_UPLOAD_DIR=uploads/cvs

# ── Legacy MongoDB (optional) ─────────────────────────────────────────────────
# MONGO_URI=mongodb://localhost:27017/
# MONGO_DB_NAME=job_scraper_db

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text
